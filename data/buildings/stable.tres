[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/buildings/building_data.gd" id="1_building"]

[resource]
script = ExtResource("1_building")
building_id = &"stable"
display_name = "Trại ngựa"
description = "Nuôi ngựa, trồng thêm cỏ khô. Xây trên ô ruộng; trên ô ◆ thì sản lượng gấp đôi. Tối đa 2. Cần thành chính cấp 3."
cost = Dictionary[StringName, int]({&"wood": 8, &"stone": 2})
allowed_terrains = Array[StringName]([&"farmland"])
max_count = 2
color = Color(0.7, 0.55, 0.3, 1)
yields = Dictionary[StringName, int]({&"food": 1, &"horses": 1})
required_castle_level = 3
