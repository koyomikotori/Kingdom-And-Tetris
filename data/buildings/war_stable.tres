[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/buildings/building_data.gd" id="1_building"]

[resource]
script = ExtResource("1_building")
building_id = &"war_stable"
display_name = "Chuồng ngựa chiến"
description = "Nuôi và huấn luyện ngựa chiến: tuyển Kỵ binh nhẹ (cấp 1), Kỵ binh thương (cấp 2), Kỵ binh nặng (cấp 3). Kỵ binh tốn Ngựa. Chỉ có 1 cái, cần thành cấp 3. Nâng cấp tới cấp thành − 2 (tối đa 3). Xây trên ô cỏ."
cost = Dictionary[StringName, int]({&"wood": 10, &"stone": 6, &"horses": 4})
allowed_terrains = Array[StringName]([&"grass"])
max_count = 1
fixed_count = true
color = Color(0.55, 0.4, 0.25, 1)
upkeep = Dictionary[StringName, int]({&"food": 1})
required_castle_level = 3
category = 1
build_turns = 3
upgrade_levels = 3
castle_level_gap = 2
