[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/buildings/building_data.gd" id="1_building"]

[resource]
script = ExtResource("1_building")
building_id = &"mine"
display_name = "Mỏ khai thác"
description = "Khai thác đá và khoáng sản. Xây trên ô đồi; trên ô ◆ thì sản lượng gấp đôi. Tối đa 3. Cần thành chính cấp 2."
cost = Dictionary[StringName, int]({&"wood": 8, &"stone": 4})
allowed_terrains = Array[StringName]([&"hill"])
max_count = 3
color = Color(0.55, 0.5, 0.45, 1)
upkeep = Dictionary[StringName, int]({&"food": 1})
yields = Dictionary[StringName, int]({&"stone": 2, &"ore": 1})
required_castle_level = 2
