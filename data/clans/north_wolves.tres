[gd_resource type="Resource" script_class="ClanData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/diplomacy/clan_data.gd" id="1_clan"]

[resource]
script = ExtResource("1_clan")
clan_id = &"north_wolves"
display_name = "Lang Tộc Phương Bắc"
description = "Những bộ tộc săn bắn trên vùng đồi đá lạnh giá. Thiện chiến, thiếu lương thực và hay dòm ngó đất phương Nam."
color = Color(0.75, 0.78, 0.85, 1)
map_position = Vector2(0.5, 0.17)
direction = 1
personality = 1
military_strength = 70
surplus = Array[StringName]([&"stone"])
deficit = Array[StringName]([&"food"])
start_relation = -10
base_relation = -15
roads = Array[StringName]([&"kingdom", &"golden_eagle"])
army_units = Dictionary[StringName, float]({&"swordsman": 3.0, &"spearman": 1.0, &"archer": 1.0})
